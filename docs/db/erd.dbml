Enum UserRole {
  CUSTOMER
  ADMIN
}

Enum MovieStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

Enum SeatType {
  REGULAR
  LOVE
  VIP
}

Enum ReservationStatus {
  PENDING
  COMPLETED
  CANCELLED
  EXPIRED
}

Table users {
  id integer [primary key, increment]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  phone varchar(50) [not null]
  profile_image_url varchar(255)
  role UserRole [default: 'CUSTOMER']
  is_active boolean [default: false]
  city_id integer
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table verification_codes {
  id integer [primary key, increment]
  user_id integer [not null]
  code varchar(6) [not null]
  expires_at timestamp [not null]
  is_used boolean [default: false]
  created_at timestamp [default: `now()`]
}

Table movies {
  id integer [primary key, increment]
  title varchar(255) [not null]
  synopsis text
  duration_minutes integer
  pg_rating varchar(8)
  language varchar(50)
  director varchar(255)
  trailer_url varchar(255)
  cover_image_url varchar(255)
  status MovieStatus [default: 'DRAFT']
  release_date date
  end_date date
  created_at timestamp [default: `now()`]
}

Table genres {
  id integer [primary key, increment]
  name varchar(50) [unique, not null]
}

Table movie_genres {
  movie_id integer
  genre_id integer
  Indexes {
    (movie_id, genre_id) [pk]
  }
}

Table crew_members {
  id integer [primary key, increment]
  first_name varchar(100)
  last_name varchar(100)
  role varchar(100)
}

Table movie_crew {
  movie_id integer
  crew_id integer
  Indexes {
    (movie_id, crew_id) [pk]
  }
}

Table movie_images {
  id integer [primary key, increment]
  movie_id integer
  image_url varchar(255)
}

Table cities {
  id integer [primary key, increment]
  name varchar(100) [not null]
  country varchar(100) [default: 'Bosnia and Herzegovina']
}

Table venues {
  id integer [primary key, increment]
  city_id integer [not null]
  name varchar(255) [not null]
  street_address varchar(255) [not null]
  phone varchar(50)
  image_url varchar(255)
}

Table halls {
  id integer [primary key, increment]
  venue_id integer [not null]
  name varchar(50)
}

Table seats {
  id integer [primary key, increment]
  hall_id integer [not null]
  row_num varchar(10) [not null]
  seat_num varchar(10) [not null]
  type SeatType [default: 'REGULAR']
  price_multiplier decimal // regular:7, vip:10, love:24
}

Table projections {
  id integer [primary key, increment]
  movie_id integer [not null]
  hall_id integer [not null]
  start_time timestamp [not null]
  created_at timestamp [default: `now()`]
}

Table reservations {
  id integer [primary key, increment]
  user_id integer [not null]
  projection_id integer [not null]
  status ReservationStatus [default: 'PENDING']
  total_price decimal
  expires_at timestamp // 5min za kupovinu, a sat prije pocetka za rezervaciju
  is_reminder_enabled boolean [default: false]
  created_at timestamp [default: `now()`]
}

Table reservation_seats {
  reservation_id integer
  seat_id integer
  Indexes {
    (reservation_id, seat_id) [pk]
  }
}

Table notifications {
  id integer [primary key, increment]
  user_id integer [not null]
  title varchar(255)
  message text
  is_read boolean [default: false]
  send_time timestamp // dan prije pocetka ako su ukljuceni reminderi...
  created_at timestamp [default: `now()`]
}

Ref: users.city_id > cities.id
Ref: verification_codes.user_id > users.id

Ref: movie_genres.movie_id > movies.id
Ref: movie_genres.genre_id > genres.id

Ref: movie_crew.movie_id > movies.id
Ref: movie_crew.crew_id > crew_members.id

Ref: movie_images.movie_id > movies.id

Ref: venues.city_id > cities.id
Ref: halls.venue_id > venues.id
Ref: seats.hall_id > halls.id

Ref: projections.movie_id > movies.id
Ref: projections.hall_id > halls.id

Ref: reservations.user_id > users.id
Ref: reservations.projection_id > projections.id

Ref: reservation_seats.reservation_id > reservations.id
Ref: reservation_seats.seat_id > seats.id

Ref: notifications.user_id > users.id